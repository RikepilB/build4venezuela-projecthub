# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright E2E artifacts — generated per run, never committed.
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# participant PII — names + LinkedIn from the hackathon sheet.
# Regenerate locally with `npm run data:builders` (do not commit to a public repo).
/data/builders.json
# self-registered builders ("add yourself") — runtime PII, kept separate from the
# imported roster so a re-import can't wipe them. Redis-backed on Vercel.
/data/builders-custom.json
/data/*.tmp
# community upvotes — runtime state written by the vote action, not seed data.
/data/votes.json
# user-attached repos (slug → repo URL + contributor count), written by the attach
# action — runtime state, not seed. Redis-backed on Vercel.
/data/repo-overrides.json
# team memberships — who joined which project (runtime PII), written by the join action.
/data/memberships.json

# machine-local agent / dev config — keep out of the public repo
/CLAUDE.local.md
# Entire .claude dir is local-only (agents, rules, skills, settings) — never committed.
/.claude/
/.mcp.json
/opencode.json

.vercel

# machine-local GSD planning state — never commit to the public repo
.planning/

# Windows shell-redirect artifacts — a `2>nul` parsed by a POSIX shell (not cmd.exe)
# drops a literal file named `nul`/`,` in the repo root. Turbopack then panics trying
# to read the reserved device name. Ignore them so they can never be committed.
/nul
/,

# Session handoff notes are internal working state — not needed to fork or run the
# app. Kept local but untracked from the public repo (curated digests, hook-written
# snapshots, session markers and transcripts alike).
docs/handoff/

# Board-audit raw debate transcripts — internal working artifact that names third-party
# repos with frank curation language. The neutral public record is the committed
# removed-from-board.md ledger; keep the raw transcript local-only.
docs/audit/**/agent_tracking_log.txt
