# Copy to .env.local (gitignored). NEVER commit real secrets.

# Data backend for the repository layer. P0 = json (local seed files).
# P1 will add: supabase
DATA_BACKEND=json

# Builders source. "build"/"local" reads the committed data/builders.json (offline-safe
# venue demo). "remote" fetches the hackathon sheet at request time (ISR-cached).
# NOTE: on Vercel the gitignored builders.json is NOT deployed, so the app auto-uses
# "remote" there unless you set BUILDERS_SOURCE=local. Set =remote locally to test sync.
BUILDERS_SOURCE=build
# How long (seconds) to cache the remote sheet before re-fetching. Default 3600 (1h).
BUILDERS_REVALIDATE=3600

# Upstash Redis (REST) — durable community votes on Vercel's read-only filesystem.
# Without these, votes persist to data/votes.json (works locally; lost on each Vercel
# deploy). Provision via Vercel Marketplace > Upstash or the Upstash console, then set
# BOTH in Vercel project settings. NEVER commit the real token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub Search API token for scripts/discover-github-repos.mjs (read-only is enough).
# Optional, but raises the rate limit 10 -> 30 req/min. Reuse your gh login:
#   $env:GITHUB_TOKEN = (gh auth token)
GITHUB_TOKEN=

# -- Deferred (P1+ - not used by the P0 MVP) --------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=        # P2 embeddings
# RESEND_API_KEY=        # P2 "need matched" emails
